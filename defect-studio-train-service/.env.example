# Image asset storage backend. Use "local" for development without S3.
IMAGE_STORAGE_BACKEND=local

# S3 object storage settings. Required only when IMAGE_STORAGE_BACKEND=s3.
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_PREFIX=
# Optional S3-compatible endpoint for local MinIO or non-AWS object storage.
S3_ENDPOINT_URL=

# Asset URL strategy for S3:
# - proxy: backend serves /api/assets/{key} from a private bucket
# - public: frontend reads directly from S3/CloudFront using S3_PUBLIC_BASE_URL
# - presigned: backend returns temporary S3 URLs
S3_URL_MODE=proxy
S3_PUBLIC_BASE_URL=
S3_PRESIGNED_TTL_SECONDS=3600

# Frontend runtime settings.
VITE_AGENT_API_URL=http://localhost:8080

# Use pnpm dev:mock for the explicit mock API profile.
