# Copy to .env. Only connection details and secrets are needed for normal use.
# SSO is required. Images upload directly to S3; ZIPs use the existing worker.
# Required local PostgreSQL password. Use a URL-safe value.
LOCAL_DB_PASSWORD=
LOCAL_DB_PORT=15439
LOCAL_API_PORT=18089
# Host uv runs only; Compose supplies db:5432 automatically.
DATABASE_URL=postgresql+psycopg2://defect:${LOCAL_DB_PASSWORD}@127.0.0.1:${LOCAL_DB_PORT}/defect_stage_local
HOST=127.0.0.1
PORT=${LOCAL_API_PORT}

# Match central web-auth's existing service key; its length policy is upstream.
SERVICE_JWT_SECRET=
# Separate local signing key retained for existing-account migration only.
SECRET_KEY=

AGENT_SERVICE_BASE_URL=https://mlp-service.n10.sr-cloud.com/service-gtr-ai-vision-defect-agent-dev
# SR Agent and object storage connect directly; other hosts may use the proxy.
HTTPS_PROXY=http://168.219.61.252:8080
HTTP_PROXY=http://168.219.61.252:8080
NO_PROXY=localhost,127.0.0.1,db,mlp-service.n10.sr-cloud.com,stage.gtrai.sec.samsung.net,gage.ap-northeast-2.samsungspc.com,.svc,.svc.cluster.local
# Enable temporarily to diagnose SSE framing; logs counts/timing, never payloads.
AGENT_SSE_TRANSPORT_DIAGNOSTICS=false

# ── Object Storage (MinIO) ──
MINIO_ENDPOINT=gage.ap-northeast-2.samsungspc.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=defect-agent
MINIO_SECURE=true
MINIO_VERIFY_SSL=true
STORAGE_CREATE_BUCKET=false
STORAGE_ALLOW_LOCAL_FALLBACK=false

# Operational limits and local paths use code defaults; override only as needed.
