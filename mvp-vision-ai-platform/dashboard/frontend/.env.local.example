# Browser-visible web-auth URL, including its configured base path.
# Keep the same hostname as Dashboard (localhost vs IP affects cookies).
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3020/auth
NEXT_PUBLIC_ACTIVATION_API_URL=http://localhost:3020/activation/dashboard

# Direct browser access to user-service. Match its actual API prefix.
NEXT_PUBLIC_USER_API_URL=http://localhost:8003/user/api/v1

# Direct local API bases. The deployed defaults are /platform/api/v1 and
# /labeler/api/v1 on the shared origin.
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_LABELER_API_URL=http://localhost:8011/api/v1
NEXT_PUBLIC_DASHBOARD_API_URL=/dashboard/api/v1

# Server-only Dashboard backend URL used by the same-origin API route.
DASHBOARD_BACKEND_API_URL=http://localhost:8021/api/v1

# Development defaults to /dashboard. Restart dev after editing these values;
# production NEXT_PUBLIC_* values must be present at build time.
NEXT_PUBLIC_BASE_PATH=/dashboard
# Leave empty on the deployed shared origin. In development, point navigation
# at an existing site; override individual URLs when using local service ports.
# NEXT_PUBLIC_LABELER_URL=http://localhost:3010/labeler
# NEXT_PUBLIC_TRAINER_URL=http://localhost:3030/platform
# NEXT_PUBLIC_RUNNER_URL=
# NEXT_PUBLIC_DEFECT_URL=
# NEXT_PUBLIC_DOCS_URL=
# NEXT_PUBLIC_DOWNLOAD_URL=
