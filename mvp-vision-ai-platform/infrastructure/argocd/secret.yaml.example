# Git repository credentials for ArgoCD (not application runtime secrets)
#
# Usage:
#   1. Copy this file: cp secret.yaml.example secret.yaml
#   2. Replace placeholders locally, never commit the resulting file
#   3. Apply: kubectl apply -f secret.yaml
#
# Note: Never commit secret.yaml to git!
apiVersion: v1
kind: Secret
metadata:
  name: vision-ai-git-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  name: vision-ai-git
  url: https://your-git-server/your-org/mvp-vision-ai-platform.git
  username: "YOUR_USERNAME"
  password: "YOUR_GIT_TOKEN"

