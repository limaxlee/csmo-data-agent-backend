{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "autoLabeling": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "executionMode": {"type": "string", "enum": ["rq", "backend"]}
      }
    },
    "workloadConsolidation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "staging": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 630
        },
        "autoLabeling": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "podSecurityContext": {
              "type": "object"
            },
            "nodeSelector": {
              "type": "object"
            },
            "tolerations": {
              "type": "array"
            },
            "affinity": {
              "type": "object"
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "connectApplications": {"type": "boolean"},
        "env": {"type": "object", "propertyNames": {"pattern": "^S3_"}}
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "postgres": {
          "type": "object",
          "properties": {
            "maxConnections": {"type": "integer", "minimum": 100, "maximum": 1000},
            "initialDatabase": {"type": "string"},
            "initDatabases": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$"}
            },
            "passwordSecret": {
              "type": "object",
              "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}},
              "oneOf": [{"maxProperties": 0}, {"required": ["name", "key"]}]
            }
          }
        },
        "pgadmin": {
          "type": "object",
          "properties": {
            "defaultPasswordSecret": {
              "type": "object",
              "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}},
              "oneOf": [{"maxProperties": 0}, {"required": ["name", "key"]}]
            }
          }
        },
        "dataVolume": {"type": "object", "properties": {"existingClaim": {"type": "string"}}},
        "pgadminVolume": {"type": "object", "properties": {"existingClaim": {"type": "string"}}}
      }
    },
    "redis": {
      "type": "object",
      "required": ["enabled", "connectApplications", "databases"],
      "properties": {
        "enabled": {"type": "boolean"},
        "connectApplications": {"type": "boolean"},
        "databases": {
          "type": "object",
          "required": ["platform", "labeler"],
          "additionalProperties": false,
          "properties": {
            "platform": {"type": "integer", "minimum": 0, "maximum": 15},
            "labeler": {"type": "integer", "minimum": 0, "maximum": 15},
            "mlService": {"type": "integer", "minimum": 0, "maximum": 15},
            "sam2UnetService": {"type": "integer", "minimum": 0, "maximum": 15}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"connectApplications": {"const": true}}},
          "then": {"properties": {"enabled": {"const": true}}}
        }
      ]
    }
  }
}
