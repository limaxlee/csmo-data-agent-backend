NEXT_PUBLIC_BASE_PATH=/
NEXT_PUBLIC_ACTIVATION_PREVIEW=false
NEXTAUTH_URL=http://localhost:3020
NEXTAUTH_SECRET=<32 바이트 이상의 무작위 문자열 - JWT 서명용>

# ADFS v4.0 OIDC 설정 (Samsung SSO)
# ADFS 는 RS256 알고리즘으로 JWT 서명 (JWKS URI 에서 공개키 자동 획득)
ADFS_CLIENT_ID=dice-web-adfs
ADFS_CLIENT_SECRET=<발급받은 Secret>

# Samsung SSO ADFS 엔드포인트
ADFS_ISSUER=https://sts.secsso.net/adfs
ADFS_ISSUER_INTERNAL=https://sts.secsso.net/adfs

# ADFS OIDC Discovery 정보:
# - issuer: https://sts.secsso.net/adfs
# - authorization_endpoint: https://sts.secsso.net/adfs/oauth2/authorize/
# - token_endpoint: https://sts.secsso.net/adfs/oauth2/token/
# - jwks_uri: https://sts.secsso.net/adfs/discovery/keys (RS256 공개키 자동 획득)
# - end_session_endpoint: https://sts.secsso.net/adfs/oauth2/logout
# - userinfo_endpoint: https://sts.secsso.net/adfs/userinfo
#
# ADFS JWT 토큰 구조 (RS256):
# HEADER: {"alg": "RS256", "typ": "JWT"}
# PAYLOAD: {"sub": "...", "upn": "...", "unique_name": "...", "iat": 12315412, "exp": ...}
# SIGNATURE: RSA(SHA256, base64UrlEncode(header) + "." + base64UrlEncode(payload), private-key)
#
# 사용 클레임 (claims_supported):
# - sub: 사용자 고유 식별자
# - upn: User Principal Name (이메일)
# - unique_name: Windows 고유 식별자
# - sid: 세션 ID

# ADFS Redirect URL 등록 필요 (ADFS 관리자에게 요청):
# https://dice.gtrai.sec.samsung.net/api/auth/callback/adfs
#
# ADFS 에 "/" 경로만 등록 가능한 경우:
#   1. AUTH_REDIRECT_URI=https://dice.gtrai.sec.samsung.net/ 로 설정
#   2. web-auth/middleware.ts 에서 "/" redirect 로직 주석 해제
#
# 명시적 redirect_uri 오버라이드 (선택 — 기본값: NEXTAUTH_URL + /api/auth/callback/adfs)
# AUTH_REDIRECT_URI=https://dice.gtrai.sec.samsung.net/api/auth/callback/adfs

# 쿠키 도메인 설정 (중요: 모든 앱이 세션 공유)
# AUTH_COOKIE_DOMAIN=.your-domain.com

AUTH_DEFAULT_CALLBACK_URL=/
NEXT_PUBLIC_AUTH_DEFAULT_CALLBACK_URL=/
AUTH_ALLOWED_CALLBACK_PREFIXES=/,/platform,/labeler,/dashboard
# For split-port local dev without a proxy:
# AUTH_ALLOWED_CALLBACK_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:3021,http://localhost:3391

# Runtime ADFS simulator (disabled by default and fail-closed without an allowlist).
# Use only in an isolated non-production environment.
DEV_LOGIN_ENABLED=false
DEV_LOGIN_ALLOWED_IDS=
DEV_LOGIN_ALLOW_ADMIN=false

# Server-side profile check for the admin-only Dashboard menu (full API base).
USER_SERVICE_API_URL=http://localhost:8003/user/api/v1
# Browser destination. Production uses /dashboard; split-port development example:
DASHBOARD_URL=http://localhost:3391/dashboard

# Activation API PostgreSQL connection. Reuses the Django activation database/tables.
ACTIVATION_DB_HOST=localhost
ACTIVATION_DB_PORT=5432
ACTIVATION_DB_NAME=activation
ACTIVATION_DB_USER=
ACTIVATION_DB_PASSWORD=
# Optional for databases that require TLS.
ACTIVATION_DB_SSL=false
# Required for product versions that use legacy AES activation keys.
# Set the existing Python activation key string in the deployment Secret.
# Keep it unchanged to remain compatible with existing product clients.
ACTIVATION_AES_KEY=

